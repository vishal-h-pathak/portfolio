# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
PROMPT_*.md

# playwright + design-system audit artifacts (local-only)
.playwright-mcp/
design-system/

__pycache__/

# planning / prompt / ops artifacts — local-only, not tracked in this repo.
# Cross-machine sync files stay TRACKED (see below): SYNC.md, CROSS_MACHINE.md,
# and the root cockpit.sh / push-cross-machine.sh.
docs/REFACTOR_PLAN.md
docs/REDESIGN_PLAN.md
docs/DASHBOARD_UX_REVIEW_2026-06.md
docs/cellular-gaits/*
!docs/cellular-gaits/SYNC.md
!docs/cellular-gaits/CROSS_MACHINE.md
ops/refactor/
ops/reports/
ops/waves/
