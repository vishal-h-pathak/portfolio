# Fleet Mission Control dashboard URL (used by the portfolio's "FLEET" nav link
# and the /fleet redirect). Defaults to https://fleet.vishal.pa.thak.io if unset.
NEXT_PUBLIC_FLEET_URL=https://fleet.vishal.pa.thak.io

# Optional read-only GitHub token (fine-grained: metadata read) used server-side
# to resolve each bench project's "last updated" date from its repo. Public
# repos resolve tokenless; private repos need this set or they fall back to the
# manual `updated` (YYYY-MM) value in content/projects/*.ts. Never exposed to the
# client.
# GITHUB_TOKEN=
